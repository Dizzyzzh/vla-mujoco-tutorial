<mujocoinclude>

    <asset>
        <!-- 木质桌面贴图与材质 -->
        <texture type="2d" name="light_wood" file="../mesh/light_wood_v3.png" />
        <material name="wood_table_mat" texture="light_wood" specular="0.5" shininess="0.5"
            rgba="0.5 0.5 0.5 1" />
        <!-- 独立机械臂立柱底座材质（深灰金属色，位于桌外 X=0） -->
        <material name="robot_pedestal_mat" rgba="0.18 0.19 0.22 1.0" specular="0.35" shininess="0.4" />
    </asset>

    <worldbody>
        <!-- ==================== 桌外独立机械臂立柱（位于 X=0, Y=0，与桌面留出安全间隙） ==================== -->
        <body name="robot_pedestal" pos="0 0 0">
            <!-- 圆柱立柱：支撑地面 (z=0) 到机械臂底座底部 (z=0.805)，半径 6cm，避免桌体阻挡机械臂下部 -->
            <geom name="robot_pedestal_col" type="cylinder" pos="0 0 0.4025" size="0.060 0.4025"
                material="robot_pedestal_mat" />
            <!-- 顶部安装法兰盘：略宽于立柱，贴合 link1 底部 -->
            <geom name="robot_pedestal_top" type="cylinder" pos="0 0 0.800" size="0.072 0.008"
                material="robot_pedestal_mat" />
        </body>

        <!-- ==================== 实验桌主体（近桌边贴近桌外立柱至 X=0.085，紧凑无多余空隙） ==================== -->
        <body name="front_object_table" pos="0 0 0" euler="0 0 0">
            <!-- 桌面盒体：中心 X=0.685、半长 0.60 → 近桌边位于 X=+0.085（紧邻半径 7.2cm 的机械臂立柱边缘），顶面 z=0.80 -->
            <geom name="front_object_table" size="0.60 0.70 0.40" pos="0.685 0 0.40" type="box"
                material="wood_table_mat" />
            <inertial pos="0 0 0" mass="1" diaginertia="0 0 0" />

            <!-- 第三人称主视角相机（居中覆盖桌边实验区与桌外机械臂） -->
            <body name="camera" pos="0.80 0.0 1.20">
                <camera name="agentview" pos="0 0 0" xyaxes="0 1 0  -0.5 0 0.707" fovy="60" />
            </body>

            <!-- 俯视角相机 -->
            <body name="camera2" pos="0.44 0.0 1.80">
                <camera name="topview" pos="0 0 0" xyaxes="0 -1 0 1 0 0" fovy="90" />
            </body>

            <!-- 侧视角辅助相机（对准桌边实验区与机械臂全貌） -->
            <body name="camera3" pos="0.16 -0.75 1.30">
                <camera name="sideview" pos="0 0 0" xyaxes="1 0 0  0 0.6179 0.7863" fovy="90" />
            </body>

        </body>
    </worldbody>

</mujocoinclude>
